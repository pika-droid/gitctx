# Rust build artifacts
/target/
**/*.rs.bk
Cargo.lock

# Reference repos (allow README.md)
/reference_repos/*
!/reference_repos/README.md

# IDE and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Ephemeral test directories
/scratch/
/tests/temp/

# Python virtual environment and caches
.venv/
__pycache__/
*.pyc
/eval/corpus/
/eval/cache/
.pytest_cache/
