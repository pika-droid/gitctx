# Rust build artifacts
/target/
**/*.rs.bk
# ONNX Runtime shared libraries (downloaded per-platform via xtask)
*.dll
*.so
*.dylib
*.dSYM
# ONNX Runtime download cache
/.ort/

# Reference repos (allow README.md)
/reference_repos/*
!/reference_repos/README.md

# IDE and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Ephemeral test directories
/scratch/
/tests/temp/
/.gitctx/

# Python virtual environment and caches
.venv/
__pycache__/
*.pyc
/eval/corpus/
/eval/cache/
/models/
.pytest_cache/
**/.fastembed_cache/

